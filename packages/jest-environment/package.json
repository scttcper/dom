{
  "name": "jest-environment-rtd",
  "version": "0.0.0",
  "private": true,
  "description": "Jest environment that installs the @rtd/dom window as globals (testEnvironment: 'rtd').",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./jest-preset": "./jest-preset.cjs",
    "./jest-preset.cjs": "./jest-preset.cjs",
    "./shims/dom": "./src/shims/dom.cjs",
    "./shims/dom-internal": "./src/shims/dom-internal.cjs",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src/shims",
    "jest-preset.cjs",
    "README.md"
  ],
  "engines": {
    "node": ">=26"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/types/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/index.js"
      },
      "./jest-preset": "./jest-preset.cjs",
      "./jest-preset.cjs": "./jest-preset.cjs",
      "./shims/dom": "./src/shims/dom.cjs",
      "./shims/dom-internal": "./src/shims/dom-internal.cjs",
      "./package.json": "./package.json"
    }
  },
  "dependencies": {
    "@jest/environment": "30.4.1",
    "@rtd/dom": "workspace:*",
    "jest-environment-node": "30.4.1",
    "@jest/fake-timers": "30.4.1",
    "jest-util": "30.4.1"
  },
  "peerDependencies": {
    "jest": ">=30.0.0"
  },
  "devDependencies": {
    "@jest/types": "30.4.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "jest": "30.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
