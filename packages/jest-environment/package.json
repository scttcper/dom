{
  "name": "@ctrl/dom-jest-environment",
  "version": "0.0.0",
  "private": true,
  "description": "Jest environment for @ctrl/dom, the fast DOM for testing React components (testEnvironment: \"@ctrl/dom-jest-environment\", or preset: \"@ctrl/dom\").",
  "keywords": [
    "jest",
    "jest-environment",
    "dom",
    "jsdom",
    "happy-dom",
    "testing",
    "react"
  ],
  "license": "MIT",
  "homepage": "https://github.com/scttcper/dom/tree/main/packages/jest-environment#readme",
  "bugs": {
    "url": "https://github.com/scttcper/dom/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scttcper/dom.git",
    "directory": "packages/jest-environment"
  },
  "author": "Scott Cooper <scttcper@gmail.com>",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./jest-preset": "./jest-preset.cjs",
    "./jest-preset.cjs": "./jest-preset.cjs",
    "./shims/dom": "./src/shims/dom.cjs",
    "./shims/dom-internal": "./src/shims/dom-internal.cjs",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src/shims",
    "jest-preset.cjs",
    "README.md"
  ],
  "engines": {
    "node": ">=26"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/types/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/index.js"
      },
      "./jest-preset": "./jest-preset.cjs",
      "./jest-preset.cjs": "./jest-preset.cjs",
      "./shims/dom": "./src/shims/dom.cjs",
      "./shims/dom-internal": "./src/shims/dom-internal.cjs",
      "./package.json": "./package.json"
    }
  },
  "dependencies": {
    "@ctrl/dom": "workspace:*",
    "@jest/environment": "^30.0.0",
    "@jest/fake-timers": "^30.0.0",
    "@jest/types": "^30.0.0",
    "jest-mock": "^30.0.0",
    "jest-util": "^30.0.0"
  },
  "peerDependencies": {
    "jest": ">=30.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "jest": "30.5.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
