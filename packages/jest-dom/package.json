{
  "name": "@rtd/jest-dom",
  "version": "0.0.0",
  "private": true,
  "description": "Drop-in replacement for @testing-library/jest-dom matchers.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.ts"
    },
    "./matchers": {
      "types": "./types/matchers-standalone.d.ts",
      "default": "./src/matchers.ts"
    },
    "./vitest": {
      "types": "./types/vitest.d.ts",
      "default": "./src/vitest.ts"
    },
    "./jest-globals": {
      "types": "./types/jest-globals.d.ts",
      "default": "./src/jest-globals.ts"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@adobe/css-tools": "4.5.0",
    "@rtd/aria": "workspace:*",
    "@rtd/dom": "workspace:*",
    "@rtd/testing-library": "workspace:*",
    "dom-accessibility-api": "0.6.3"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "happy-dom": "21.0.4",
    "jsdom": "30.1.3",
    "vitest-environment-rtd": "workspace:*"
  },
  "peerDependencies": {
    "vitest": ">= 0.32"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  }
}
