{
  "version": "0.0.0",
  "private": true,
  "description": "Vitest environment that installs the @ctrl/dom window as globals (environment: 'ctrl-dom').",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./failure-snapshot": "./src/failure-snapshot.ts"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=26"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/types/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/index.js"
      },
      "./failure-snapshot": {
        "types": "./dist/types/failure-snapshot.d.ts",
        "default": "./dist/failure-snapshot.js"
      },
      "./package.json": "./package.json"
    }
  },
  "dependencies": {
    "@ctrl/dom": "workspace:*"
  },
  "peerDependencies": {
    "vitest": ">=5.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "happy-dom": "21.0.4",
    "jsdom": "30.1.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
