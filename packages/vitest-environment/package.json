{
  "version": "0.0.0",
  "private": true,
  "description": "Vitest environment that installs the @ctrl/dom window as globals (environment: 'ctrl-dom').",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./plugin": "./src/plugin.ts",
    "./failure-snapshot": "./src/failure-snapshot.ts",
    "./jsx-runtime": "./src/jsx-runtime.ts",
    "./jsx-dev-runtime": "./src/jsx-dev-runtime.ts",
    "./shared-workers": "./src/shared-workers.ts",
    "./prewarm": "./src/prewarm.ts"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=26"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/types/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/index.js"
      },
      "./plugin": {
        "types": "./dist/types/plugin.d.ts",
        "default": "./dist/plugin.js"
      },
      "./failure-snapshot": {
        "types": "./dist/types/failure-snapshot.d.ts",
        "default": "./dist/failure-snapshot.js"
      },
      "./jsx-runtime": {
        "types": "./dist/types/jsx-runtime.d.ts",
        "default": "./dist/jsx-runtime.js"
      },
      "./jsx-dev-runtime": {
        "types": "./dist/types/jsx-dev-runtime.d.ts",
        "default": "./dist/jsx-dev-runtime.js"
      },
      "./shared-workers": {
        "types": "./dist/types/shared-workers.d.ts",
        "default": "./dist/shared-workers.js"
      },
      "./prewarm": {
        "types": "./dist/types/prewarm.d.ts",
        "default": "./dist/prewarm.js"
      },
      "./package.json": "./package.json"
    }
  },
  "dependencies": {
    "@ctrl/dom": "workspace:*"
  },
  "peerDependencies": {
    "vitest": ">=5.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "happy-dom": "21.0.4",
    "jsdom": "31.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
