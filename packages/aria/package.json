{
  "name": "@rtd/aria",
  "version": "0.0.0",
  "private": true,
  "description": "ARIA roles, accessible name/description and states (replaces aria-query + dom-accessibility-api).",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./internal": "./src/internal.ts"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=26"
  },
  "publishConfig": {
    "main": "./dist/index.cjs",
    "types": "./dist/types/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/types/index.d.ts",
        "require": "./dist/index.cjs",
        "default": "./dist/index.js"
      },
      "./internal": {
        "types": "./dist/types/internal.d.ts",
        "require": "./dist/internal.cjs",
        "default": "./dist/internal.js"
      },
      "./package.json": "./package.json"
    }
  },
  "dependencies": {
    "@rtd/dom": "workspace:*"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "aria-query": "5.3.0",
    "dom-accessibility-api": "0.5.16",
    "dom-accessibility-api-0.6": "npm:dom-accessibility-api@0.6.3",
    "happy-dom": "21.0.4",
    "jsdom": "30.1.3"
  }
}
