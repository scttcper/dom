{
  "version": "0.0.0",
  "private": true,
  "description": "A DOM for testing React components (replaces jsdom / happy-dom).",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./internal": "./src/internal.ts"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=26"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/types/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/index.js"
      },
      "./internal": {
        "types": "./dist/types/internal.d.ts",
        "default": "./dist/internal.js"
      },
      "./package.json": "./package.json"
    }
  },
  "devDependencies": {
    "@ctrl/dom": "workspace:*",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "happy-dom": "21.0.4",
    "jsdom": "30.1.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
