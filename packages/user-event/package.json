{
  "name": "@rtd/user-event",
  "version": "0.0.0",
  "private": true,
  "description": "Drop-in replacement for @testing-library/user-event.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "dependencies": {
    "@rtd/dom": "workspace:*",
    "@rtd/testing-library": "workspace:*"
  },
  "devDependencies": {
    "@testing-library/user-event": "14.6.8",
    "@testing-library/dom": "10.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "happy-dom": "21.0.4",
    "jsdom": "30.1.3",
    "vitest-environment-rtd": "workspace:*",
    "@rtd/react": "workspace:*"
  },
  "imports": {
    "#src/*": "./src/*",
    "#testHelpers": "./test/upstream/_helpers/index.ts",
    "#testHelpers/*": "./test/upstream/_helpers/*"
  }
