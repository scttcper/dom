{
  "name": "@rtd/sentry",
  "version": "0.0.0",
  "private": true,
  "description": "Test observability in Sentry: test files as traces (spans for queries, waitFor, user-event actions and renders), failing tests as issues with the page attached, flaky tests as issues.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./vitest": "./src/vitest.ts",
    "./vitest-setup": "./src/vitest-setup.ts",
    "./jest": "./src/jest.ts",
    "./jest-collector": "./src/jest-collector.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=26"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/types/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/index.js"
      },
      "./vitest": {
        "types": "./dist/types/vitest.d.ts",
        "default": "./dist/vitest.js"
      },
      "./vitest-setup": {
        "types": "./dist/types/vitest-setup.d.ts",
        "default": "./dist/vitest-setup.js"
      },
      "./jest": {
        "types": "./dist/types/jest.d.ts",
        "default": "./dist/jest.js"
      },
      "./jest-collector": {
        "types": "./dist/types/jest-collector.d.ts",
        "default": "./dist/jest-collector.js"
      },
      "./package.json": "./package.json"
    }
  },
  "dependencies": {
    "@rtd/dom": "workspace:*",
    "@rtd/testing-library": "workspace:*"
  },
  "devDependencies": {
    "@rtd/react": "workspace:*",
    "@rtd/user-event": "workspace:*",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vitest-environment-rtd": "workspace:*"
  },
  "peerDependencies": {
    "vitest": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  }
}
