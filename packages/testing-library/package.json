{
  "version": "0.0.0",
  "private": true,
  "description": "Drop-in replacement for @testing-library/dom.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.ts"
    },
    "./agent": {
      "types": "./types/agent.d.ts",
      "default": "./src/agent.ts"
    }
  },
  "files": [
    "dist",
    "types",
    "README.md"
  ],
  "engines": {
    "node": ">=26"
  },
  "publishConfig": {
    "main": "./dist/index.cjs",
    "types": "./types/index.d.ts",
    "exports": {
      ".": {
        "types": "./types/index.d.ts",
        "require": "./dist/index.cjs",
        "default": "./dist/index.js"
      },
      "./agent": {
        "types": "./types/agent.d.ts",
        "require": "./dist/agent.cjs",
        "default": "./dist/agent.js"
      },
      "./package.json": "./package.json"
    }
  },
  "dependencies": {
    "@babel/code-frame": "^8.0.6",
    "@ctrl/dom": "workspace:*",
    "picocolors": "^1.1.1",
    "pretty-format": "^30.5.1"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "happy-dom": "21.0.4",
    "jsdom": "30.1.3"
  }
}
