{
  "name": "@rtd/react",
  "version": "0.0.0",
  "private": true,
  "description": "Drop-in replacement for @testing-library/react.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./pure": "./src/pure.ts",
    "./dont-cleanup-after-each": "./src/dont-cleanup-after-each.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=26"
  },
  "publishConfig": {
    "main": "./dist/index.cjs",
    "types": "./dist/types/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/types/index.d.ts",
        "require": "./dist/index.cjs",
        "default": "./dist/index.js"
      },
      "./pure": {
        "types": "./dist/types/pure.d.ts",
        "require": "./dist/pure.cjs",
        "default": "./dist/pure.js"
      },
      "./dont-cleanup-after-each": {
        "types": "./dist/types/dont-cleanup-after-each.d.ts",
        "require": "./dist/dont-cleanup-after-each.cjs",
        "default": "./dist/dont-cleanup-after-each.js"
      },
      "./package.json": "./package.json"
    }
  },
  "dependencies": {
    "@rtd/dom": "workspace:*",
    "@rtd/testing-library": "workspace:*"
  },
  "peerDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@rtd/jest-dom": "workspace:*",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "happy-dom": "21.0.4",
    "jsdom": "30.1.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vitest-environment-rtd": "workspace:*",
    "@testing-library/dom": "10.4.2"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    },
    "@types/react-dom": {
      "optional": true
    }
  }
}
