{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 120,
  // Keep the hand-ordered package.json keys.
  "sortPackageJson": false,
  "ignorePatterns": [
    // Vendored web-platform-tests and css-parsing-tests files, kept byte-for-byte.
    "packages/dom/test/wpt/fixtures/**",
    "packages/dom/test/css/wpt/**",
    "packages/dom/test/css/fixtures/**",
    "packages/dom/test/html/wpt/**",
    "packages/dom/test/selectors/wpt/**",
    // Written by scripts: the WPT expectations, accname cases, data tables and downstream baseline.
    "packages/dom/test/wpt/expectations/**",
    "packages/dom/test/wpt/expectations.json",
    "packages/aria/test/wpt/**",
    "**/*.generated.ts",
    "packages/dom/src/css/data/properties.ts",
    "packages/dom/src/parser/entities-data.ts",
    "downstream/baseline.json",
    // Docs and reports, several regenerated by scripts (pnpm docs:spec, pnpm docs:compat, bench and downstream results).
    "**/*.md",
    // Typings that track the upstream packages' files, kept in their layout so they diff cleanly.
    "packages/*/types/**"
  ],
  "overrides": [
    {
      // Ported upstream code keeps upstream's Prettier config (kcd-scripts), so it still diffs against the original.
      "files": [
        "packages/user-event/**",
        "packages/jest-dom/test/upstream/**",
        "packages/testing-library/test/upstream/**",
        "packages/testing-library/test/upstream-node/**",
        "packages/testing-library/test/helpers/**"
      ],
      "excludeFiles": ["packages/user-event/test/wpt/**", "packages/user-event/vitest.config.ts"],
      "options": {
        "printWidth": 80,
        "semi": false,
        "singleQuote": true,
        "bracketSpacing": false,
        "arrowParens": "avoid"
      }
    },
    {
      // Ported dom-accessibility-api tests keep its Prettier config.
      "files": [
        "packages/aria/test/accessible-description.test.ts",
        "packages/aria/test/accessible-name.test.ts",
        "packages/aria/test/getRole.test.ts"
      ],
      "options": { "printWidth": 80, "useTabs": true }
    }
  ]
}
